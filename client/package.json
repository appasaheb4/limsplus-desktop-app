{
  "name": "limsplus-connect",
  "version": "1.0.0",
  "description": "LimsPlus Connect",
  "homepage": ".",
  "main": "build/electron/main.js",
  "private": true,
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "postinstall": "electron-builder install-app-deps",
    "dev": "concurrently \"cross-env BROWSER=none yarn start\" \"wait-on http://127.0.0.1:3000 && tsc -p electron -w\" \"wait-on http://127.0.0.1:3000 && tsc -p electron && electron .\"",
    "electron:dev": "concurrently \"cross-env BROWSER=none yarn start\" \"wait-on http://127.0.0.1:3000 && tsc -p electron -w\" \"wait-on http://127.0.0.1:3000 && tsc -p electron && electron .\"",
    "electron:build": "rm -rf dist && yarn build && tsc -p electron && electron-builder",
    "eject": "react-scripts eject"
  },
  "dependencies": {
    "@apollo/client": "^3.12.6",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/electron-devtools-installer": "^2.2.2",
    "@types/jest": "^29.4.0",
    "@types/node": "^18.13.0",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "apollo-upload-client": "16.0.0",
    "axios": "^1.7.9",
    "electron-devtools-installer": "^3.2.0",
    "electron-reload": "^1.5.0",
    "form-data": "^4.0.1",
    "fs": "^0.0.1-security",
    "lodash": "^4.17.21",
    "mobx": "^6.13.5",
    "mobx-react": "^9.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.1.2",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^3.1.1"
  },
  "build": {
    "appId": "com.limsplus.connect",
    "productName": "LimsPlus Connect",
    "extends": null,
    "files": [
      "build/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "${productName}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "browser": {
    "fs": false,
    "path": false,
    "os": false
  },
  "devDependencies": {
    "@types/apollo-upload-client": "^17.0.0",
    "@types/lodash": "^4.17.14",
    "concurrently": "^7.6.0",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^23.6.0",
    "tailwindcss": "^3.4.17",
    "wait-on": "^7.0.1"
  }
}
