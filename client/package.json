{
  "name": "limsplus-connect",
  "version": "1.0.16",
  "author": "Lakade Appasaheb",
  "description": "LimsPlus Connect",
  "homepage": ".",
  "main": "build/electron/main.js",
  "private": true,
  "scripts": {
    "build:server": "node build-server.js",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "postinstall": "electron-builder install-app-deps",
    "dev": "concurrently \"cross-env BROWSER=none yarn start\" \"wait-on http://127.0.0.1:3000 && tsc -p electron -w\" \"wait-on http://127.0.0.1:3000 && tsc -p electron && cross-env LIMSPLUS_CONNECT_DEV_URL=http://127.0.0.1:3000 NODE_OPTIONS= electron .\"",
    "dev:with-devtools": "cross-env LIMSPLUS_OPEN_DEVTOOLS=true yarn dev",
    "dev:with-rdt": "cross-env LIMSPLUS_REACT_DEVTOOLS=true yarn dev",
    "dev:debug-ui": "cross-env LIMSPLUS_OPEN_DEVTOOLS=true LIMSPLUS_REACT_DEVTOOLS=true yarn dev",
    "reset-activation": "node scripts/clear-license-activation.js",
    "reset-lims-lite-setup": "node scripts/reset-lims-lite-setup.js",
    "electron:dev": "concurrently \"cross-env BROWSER=none yarn start\" \"wait-on http://127.0.0.1:3000 && tsc -p electron -w\" \"wait-on http://127.0.0.1:3000 && tsc -p electron && cross-env LIMSPLUS_OPEN_DEVTOOLS=true LIMSPLUS_CONNECT_DEV_URL=http://127.0.0.1:3000 NODE_OPTIONS= electron .\"",
    "electron:dev:activation": "yarn reset-activation && yarn electron:dev",
    "electron:dev:no-devtools": "concurrently \"cross-env BROWSER=none yarn start\" \"wait-on http://127.0.0.1:3000 && tsc -p electron -w\" \"wait-on http://127.0.0.1:3000 && tsc -p electron && cross-env LIMSPLUS_OPEN_DEVTOOLS=false LIMSPLUS_CONNECT_DEV_URL=http://127.0.0.1:3000 NODE_OPTIONS= electron .\"",
    "electron:dev:with-devtools": "yarn electron:dev",
    "electron:dev:with-rdt": "cross-env LIMSPLUS_REACT_DEVTOOLS=true yarn electron:dev",
    "clean:mac": "rm -rf dist",
    "clean:win": "rm -rf dist",
    "electron:build-mac": "yarn clean:mac && yarn build && tsc -p electron && yarn build:server && node ../scripts/sync-lite-product-name.js && node ../scripts/write-install-identity.js && electron-builder --mac",
    "electron:build-win": "yarn clean:win && yarn build && tsc -p electron && yarn build:server && node ../scripts/sync-lite-product-name.js && node ../scripts/write-install-identity.js && electron-builder --win",
    "eject": "react-scripts eject",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "prettier:fix": "prettier --write ."
  },
  "dependencies": {
    "@apollo/client": "^3.12.6",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/electron-devtools-installer": "^2.2.2",
    "@types/jest": "^29.4.0",
    "@types/node": "^18.13.0",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "adm-zip": "^0.5.17",
    "apollo-upload-client": "16.0.0",
    "axios": "^1.7.9",
    "electron-devtools-installer": "^3.2.0",
    "electron-reload": "^1.5.0",
    "form-data": "^4.0.1",
    "fs": "^0.0.1-security",
    "lodash": "^4.17.21",
    "mobx": "^6.13.5",
    "mobx-react": "^9.2.0",
    "mongodb": "^7.2.0",
    "mongodb-memory-server": "^11.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.1.2",
    "react-scripts": "5.0.1",
    "serve-handler": "^6.1.5",
    "typescript": "^4.9.5",
    "web-vitals": "^3.1.1"
  },
  "build": {
    "appId": "com.limsplus.connect",
    "productName": "LIMSPLUS Lite 1.0.16",
    "copyright": "Copyright © 2026 LimsPlus",
    "publish": null,
    "extends": null,
    "asarUnpack": [
      "**/node_modules/mongodb-memory-server/**/*",
      "**/node_modules/mongodb-memory-server-core/**/*"
    ],
    "files": [
      "build/**/*",
      "electron/**/*",
      {
        "from": "electron/server/",
        "to": "Resources/server/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "electron/server/",
        "to": "server/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "app/frontend",
        "to": "portal-build",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "app/backend",
        "to": "lite-backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "database",
        "to": "database",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets/install-identity.json",
        "to": "install-identity.json"
      }
    ],
    "directories": {
      "buildResources": "assets"
    },
    "mac": {
      "target": [
        "dmg",
        "pkg"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.medical"
    },
    "pkg": {
      "scripts": "installer/mac/pkg-scripts",
      "installLocation": "/Applications",
      "allowAnywhere": false,
      "allowCurrentUserHome": false,
      "allowRootDirectory": false,
      "isRelocatable": false,
      "overwriteAction": "upgrade"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName} Setup.${ext}",
      "requestedExecutionLevel": "requireAdministrator",
      "legalTrademarks": "(c) 2024 https://www.limsplus.co.in",
      "publisherName": "LimsPlus"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LIMSPLUS Lite 1.0.16",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true,
      "include": "installer/nsis/installer.nsh"
    },
    "dmg": {
      "title": "LIMSPLUS Lite 1.0.16",
      "icon": "assets/icon.icns",
      "artifactName": "${productName}.${ext}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "browser": {
    "fs": false,
    "path": false,
    "os": false
  },
  "devDependencies": {
    "@types/apollo-upload-client": "^17.0.0",
    "@types/lodash": "^4.17.14",
    "concurrently": "^7.6.0",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "wait-on": "^7.0.1"
  }
}
